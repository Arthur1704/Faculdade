<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="WebApplication1.SiteMaster" %>
<!DOCTYPE html>
<html lang="pt-BR">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Caderneta de Obras</asp:ContentPlaceHolder></title>
    <link rel="stylesheet" href="css/site.css" />
</head>
<body>
<form id="mainForm" runat="server">
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <div class="brand">
                <div class="brand-mark">CO</div>
                <div><strong>Caderneta de Obras</strong><span>Gestão de obras</span></div>
            </div>
            <nav class="menu">
                <a href="inicio.aspx" class="menu-item"><span class="icon">⌂</span>Início</a>
                <div class="menu-label">Cadastros</div>
                <a href="proprietarios.aspx" class="menu-item"><span class="icon">♙</span>Proprietários</a>
                <a href="profissionais.aspx" class="menu-item"><span class="icon">⚒</span>Profissionais</a>
                <a href="usuarios.aspx" id="menuUsuarios" runat="server" class="menu-item"><span class="icon">◉</span>Usuários</a>
                <a href="backup.aspx" id="menuBackup" runat="server" class="menu-item"><span class="icon">⛁</span>Backup</a>
                <div class="menu-label">Obras</div>
                <a href="obras.aspx" class="menu-item"><span class="icon">⌂</span>Obras</a>
                <a href="tipos-obra.aspx" class="menu-item"><span class="icon">▤</span>Tipos de obra</a>
                <a href="servicos.aspx" class="menu-item"><span class="icon">✓</span>Serviços</a>
                <a href="recibos.aspx" class="menu-item"><span class="icon">▣</span>Recibos</a>
                <a href="relato-visita.aspx" class="menu-item"><span class="icon">✎</span>Relato de visita</a>
                <a href="termo-conclusao.aspx" class="menu-item"><span class="icon">✓</span>Termo de conclusão</a>
            </nav>
            <div class="sidebar-footer">Caderneta de Obras<br />Sistema de gestão de obras</div>
        </aside>
        <main class="main-content">
            <header class="topbar">
                <button type="button" class="icon-button mobile-menu" onclick="toggleSidebar()" aria-label="Abrir menu">☰</button>
                <div class="breadcrumb"><a href="inicio.aspx">Início</a><span>/</span><asp:ContentPlaceHolder ID="BreadcrumbContent" runat="server">Painel</asp:ContentPlaceHolder></div>
                <div class="topbar-user">
                    <span class="avatar"><asp:Label ID="lblIniciais" runat="server" /></span>
                    <div><strong><asp:Label ID="lblNomeUsuario" runat="server" /></strong><small><asp:Label ID="lblPerfilUsuario" runat="server" /></small></div>
                    <asp:LinkButton ID="lnkSair" runat="server" CssClass="btn btn-small" OnClick="lnkSair_Click" CausesValidation="false">Sair</asp:LinkButton>
                </div>
            </header>
            <section class="page-content">
                <asp:Panel ID="pnlMensagem" runat="server" Visible="false" CssClass="alert alert-success page-alert">
                    <asp:Label ID="lblMensagem" runat="server" />
                </asp:Panel>
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </section>
        </main>
    </div>
</form>
<script src="js/app.js"></script>
</body>
</html>
